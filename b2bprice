    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 15px; max-width: 600px; margin: 0 auto; background-color: #f4f5f7; color: #222; }
        
        /* Фирменный стиль Madlen Fabrica */
        .brand-header { 
            background-color: #cc1b23; 
            color: #ffffff; 
            text-align: center; 
            padding: 30px 15px 35px 15px; 
            border-radius: 12px; 
            box-shadow: 0 4px 12px rgba(204, 27, 35, 0.25); 
            position: relative; 
            overflow: hidden;
            margin-bottom: 20px;
        }
        .brand-logo { 
            font-family: Georgia, serif;
            font-size: 36px; 
            font-weight: bold; 
            letter-spacing: 0.5px;
            margin: 0; 
            line-height: 1.1;
        }
        .brand-divider {
            width: 120px;
            height: 1px;
            background: rgba(255, 255, 255, 0.6);
            margin: 8px auto;
        }
        .brand-sub { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 15px; 
            text-transform: uppercase; 
            letter-spacing: 3px; 
            margin: 0; 
            font-weight: 500;
        }
        /* Желтая фирменная волна */
        .brand-wave {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 12px;
            background: #ffd100;
            border-top-left-radius: 50% 100%;
            border-top-right-radius: 50% 100%;
            transform: scaleX(1.2);
        }

        .form-group { margin-bottom: 12px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; font-size: 14px; color: #333; }
        input[type="text"], textarea { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 15px; outline: none; background: #fff; }
        input[type="text"]:focus, textarea:focus { border-color: #cc1b23; }

        .catalog { margin-top: 20px; background: #fff; padding: 15px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .catalog h3 { margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #f0f0f0; padding-bottom: 10px; font-size: 18px; color: #cc1b23; }

        /* Вкладки */
        .tabs { display: flex; gap: 6px; overflow-x: auto; margin-bottom: 15px; padding-bottom: 5px; scrollbar-width: thin; }
        .tabs::-webkit-scrollbar { height: 4px; }
        .tabs::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }
        .tab-btn { padding: 8px 12px; background: #f0f0f0; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; white-space: nowrap; color: #555; transition: all 0.2s; }
        .tab-btn.active { background: #cc1b23; color: #fff; }

        .tab-pane { display: none; }
        .tab-pane.active { display: block; }

        .product-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #eee; }
        .product-item:last-child { border-bottom: none; }
        .product-info { flex-grow: 1; padding-right: 10px; }
        .product-title { font-weight: 600; font-size: 14px; line-height: 1.3; }
        .product-price { color: #666; font-size: 13px; margin-top: 3px; font-weight: bold; }

        .qty-controls { display: flex; align-items: center; gap: 6px; }
        .qty-btn { width: 36px; height: 36px; border: 1px solid #ddd; background: #f8f9fa; font-weight: bold; cursor: pointer; border-radius: 6px; font-size: 18px; display: flex; align-items: center; justify-content: center; -webkit-tap-highlight-color: transparent; }
        .qty-btn:active { background: #e2e6ea; }
        .qty-input { width: 45px !important; text-align: center; padding: 6px 2px !important; margin: 0; font-size: 16px; font-weight: bold; border: 1px solid #ddd; border-radius: 6px; }

        .total-box { font-size: 18px; font-weight: 700; text-align: right; margin-top: 15px; padding-top: 10px; border-top: 2px solid #f0f0f0; color: #cc1b23; }
        .send-btn { width: 100%; padding: 15px; background-color: #25D366; color: white; border: none; border-radius: 10px; font-size: 17px; font-weight: bold; cursor: pointer; margin-top: 15px; box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3); }
