                    <div class="product-price">710 ₸</div>
                </div>
                <div class="qty-controls">
                    <button class="qty-btn" onclick="changeQty('p25', -1)">-</button>
                    <input type="number" id="p25" class="qty-input" value="0" min="0" data-name="Печенье &quot;Madlen&quot; Пакет 0,5 кг." data-price="710" onchange="calculateTotal()">
                    <button class="qty-btn" onclick="changeQty('p25', 1)">+</button>
                </div>
            </div>
        </div>

        <!-- Вкладка 5: Чак-Чак -->
        <div id="tab5" class="tab-pane">
            <div class="product-item">
                <div class="product-info">
                    <div class="product-title">Чак-Чак "Медовый с миндалём" Шоу Бокс 20 шт по 28 гр.</div>
                    <div class="product-price">2 625 ₸</div>
                </div>
                <div class="qty-controls">
                    <button class="qty-btn" onclick="changeQty('p26', -1)">-</button>
                    <input type="number" id="p26" class="qty-input" value="0" min="0" data-name="Чак-Чак &quot;Медовый с миндалём&quot; Шоу Бокс 20 шт по 28 гр." data-price="2625" onchange="calculateTotal()">
                    <button class="qty-btn" onclick="changeQty('p26', 1)">+</button>
                </div>
            </div>
            <div class="product-item">
                <div class="product-info">
                    <div class="product-title">Чак-Чак "Медовый" Коробка 0,150кг</div>
                    <div class="product-price">635 ₸</div>
                </div>
                <div class="qty-controls">
                    <button class="qty-btn" onclick="changeQty('p27', -1)">-</button>
                    <input type="number" id="p27" class="qty-input" value="0" min="0" data-name="Чак-Чак &quot;Медовый&quot; Коробка 0,150кг" data-price="635" onchange="calculateTotal()">
                    <button class="qty-btn" onclick="changeQty('p27', 1)">+</button>
                </div>
            </div>
        </div>

        <div class="total-box">Итого: <span id="totalSum">0</span> ₸</div>
    </div>

    <div class="form-group" style="margin-top: 15px;">
        <label>Комментарий к заказу:</label>
        <textarea id="comment" rows="3" placeholder="Дополнительные пожелания..."></textarea>
    </div>

    <button class="send-btn" onclick="sendToWhatsApp()">Отправить в WhatsApp</button>

    <script>
        function switchTab(evt, tabId) {
            const panes = document.querySelectorAll('.tab-pane');
            panes.forEach(pane => pane.classList.remove('active'));

            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => btn.classList.remove('active'));

            document.getElementById(tabId).classList.add('active');
            evt.currentTarget.classList.add('active');
        }

        function changeQty(id, delta) {
            const input = document.getElementById(id);
            let val = parseInt(input.value) || 0;
            val = Math.max(0, val + delta);
            input.value = val;
            calculateTotal();
        }

        function calculateTotal() {
            const items = document.querySelectorAll('.qty-input');
            let total = 0;
            items.forEach(item => {
                const qty = parseInt(item.value) || 0;
                const price = parseInt(item.getAttribute('data-price')) || 0;
                total += qty * price;
            });
            document.getElementById('totalSum').innerText = total;
        }

        function sendToWhatsApp() {
            const ipName = document.getElementById('ipName').value.trim();
            const address = document.getElementById('address').value.trim();
            const comment = document.getElementById('comment').value.trim();
            const items = document.querySelectorAll('.qty-input');

            let orderList = "";
            let totalSum = 0;

            items.forEach(item => {
                const qty = parseInt(item.value) || 0;
                if (qty > 0) {
                    const name = item.getAttribute('data-name');
                    const price = parseInt(item.getAttribute('data-price'));
                    const sum = qty * price;
                    totalSum += sum;
                    orderList += `• ${name} — ${qty} шт. x ${price} = ${sum} ₸\n`;
                }
            });

            if (!orderList) {
                alert("Выберите хотя бы один товар!");
                return;
            }

            let message = "📦 *Новый заказ — Madlen Fabrica*\n\n";
            if (ipName) message += `🏢 *ИП:* ${ipName}\n`;
            if (address) message += `📍 *Адрес:* ${address}\n`;
            
            message += `\n🛒 *Выбранные товары:*\n${orderList}`;
            message += `\n💰 *Итого:* ${totalSum} ₸\n`;
            
            if (comment) message += `\n📝 *Комментарий:* ${comment}\n`;

            const waUrl = "https://api.whatsapp.com/send?text=" + encodeURIComponent(message);
            window.open(waUrl, '_blank');
        }
    </script>

</body>
</html>
